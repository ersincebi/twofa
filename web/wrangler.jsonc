{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "twofa",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [{ "pattern": "2fa.ersincebi.com", "custom_domain": true }],
  // Preview URLs would expose the same vault under extra hostnames.
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "VAULT", "class_name": "Vault" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Vault"] }],
  "observability": { "enabled": true }
}
